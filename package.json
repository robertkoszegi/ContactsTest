{
  "name": "contactstest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "ultracite check",
    "deploy": "proofkit deploy",
    "dev": "vite",
    "fix": "ultracite fix",
    "format": "ultracite fix .",
    "lint": "ultracite check .",
    "prepare": "husky",
    "serve": "vite preview",
    "start": "vite",
    "typegen": "pnpx @proofkit/typegen --config proofkit.config.json",
    "typegen:ui": "pnpx @proofkit/typegen ui --config proofkit.config.json"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@proofkit/fmdapi": "^5.1.2",
    "@proofkit/webviewer": "^3.1.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.167.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.4",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.10",
    "tw-animate-css": "^1.4.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@proofkit/typegen": "^1.1.3",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^6.0.3",
    "ultracite": "^7.10.7",
    "vite": "^7.3.3",
    "vite-plugin-singlefile": "^2.3.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm exec ultracite fix"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.12.0 || ^24.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "proofkitMetadata": {
    "initVersion": "3.2.0",
    "scaffoldPackage": "@proofkit/cli"
  }
}
